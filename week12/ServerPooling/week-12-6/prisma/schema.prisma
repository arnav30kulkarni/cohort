generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  direct_url = env("DIRECT_DATABASE_URL")
}

model Log {
    id       Int      @id @default(autoincrement())
    level    Level 
    message  String
    metadata Json
}

enum    Level {
    Info
    Warn
    Error
}